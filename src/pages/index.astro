---
import '../styles/global.css';
import data from '../../data.json';

type Item = {
  brand: string; sku: string; us_code?: string; group: string; type: string;
  drive?: string; spec: string; price: string; status: string; source: string;
  url: string; image: string;
};

const tone = data.tone as Item[];
const milwaukee = data.milwaukee as Item[];


// drive size: TONE has it in data; Milwaukee is read from the model code (F14 / F38 / F12 / R38)
const DRIVES: Record<string, string> = { '14': '1/4"', '38': '3/8"', '12': '1/2"' };
const driveOf = (r: Item) => r.drive ?? DRIVES[r.sku.match(/[FR](14|38|12)(?:-|$)/)?.[1] ?? ''] ?? '';

// one flat list, file order; category label shown on each card
const items = [
  ...tone.map((r) => ({ ...r, brandName: 'TONE', cat: `${r.group} ${r.type}`.trim() })),
  ...milwaukee.map((r) => ({ ...r, brandName: 'Milwaukee', cat: r.group })),
];

const filters = [
  { key: 'brand', label: 'Brand', options: ['TONE', 'Milwaukee'] },
  { key: 'status', label: 'Status', options: ['Purchased', 'Shortlist'] },
  { key: 'drive', label: 'Drive', options: ['1/4"', '3/8"', '1/2"'] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Tool wishlist — TONE & Milwaukee</title>
  </head>
  <body>
    <main>
      <div class="filters">
        {filters.map((f) => (
          <div class="row" data-filter={f.key}>
            <span class="lbl">{f.label}</span>
            <button type="button" data-value="" aria-pressed="true">All</button>
            {f.options.map((o) => <button type="button" data-value={o} aria-pressed="false">{o}</button>)}
          </div>
        ))}
        <select id="sort" aria-label="Sort">
          <option value="">Sort: Default</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="sku">SKU: A–Z</option>
        </select>
        <span class="count" id="count"></span>
      </div>
      <div class="grid">
        {items.map((r, i) => {
          const isBought = r.status === 'Purchased';
          const sub = r.brandName === 'TONE' ? r.drive : `US ${r.us_code} · ${r.type}`;
          return (
            <a
              class:list={['card', { bought: isBought }]}
              href={r.url}
              target="_blank"
              rel="noopener"
              data-brand={r.brandName}
              data-status={r.status}
              data-drive={driveOf(r)}
              data-i={i}
              data-price={Number(r.price.replace(/[^0-9.]/g, '')) || 0}
              data-sku={r.sku}
            >
              <div class="img"><img src={'/' + r.image} alt={r.sku} loading="lazy" /></div>
              <div class="cat">{r.brandName} {r.cat}</div>
              <div class="sku">{r.sku}</div>
              <div class="sub">{sub}</div>
              <div class="spec">{r.spec}</div>
              <div class="price">{isBought ? 'Purchased' : r.price}</div>
              <div class="src">{r.source}</div>
            </a>
          );
        })}
      </div>
      <p class="empty" id="empty" hidden>No items match these filters.</p>
    </main>

    <script>
      const state: Record<string, string> = { brand: '', status: '', drive: '' };
      const cards = [...document.querySelectorAll<HTMLElement>('.card')];
      const count = document.getElementById('count')!;

      function apply() {
        let shown = 0;
        for (const c of cards) {
          const d = c.dataset;
          const ok =
            (!state.brand || d.brand === state.brand) &&
            (!state.status || d.status === state.status) &&
            (!state.drive || d.drive === state.drive);
          c.hidden = !ok;
          if (ok) shown++;
        }
        document.getElementById('empty')!.hidden = shown > 0;
        count.textContent = `${shown} of ${cards.length} items`;
      }

      document.querySelectorAll<HTMLElement>('[data-filter]').forEach((row) => {
        row.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('button');
          if (!btn) return;
          row.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          state[row.dataset.filter!] = btn.dataset.value ?? '';
          apply();
        });
      });
      const grid = document.querySelector<HTMLElement>('main .grid')!;
      const sortSel = document.getElementById('sort') as HTMLSelectElement;
      sortSel.addEventListener('change', () => {
        const v = sortSel.value;
        const key = (c: HTMLElement) => Number(c.dataset.price);
        const noPrice = (a: HTMLElement, b: HTMLElement) => +!key(a) - +!key(b); // unpriced items last
        const sorted = [...cards].sort((a, b) =>
          v === 'price-asc' ? noPrice(a, b) || key(a) - key(b) || +a.dataset.i! - +b.dataset.i!
          : v === 'price-desc' ? noPrice(a, b) || key(b) - key(a) || +a.dataset.i! - +b.dataset.i!
          : v === 'sku' ? a.dataset.sku!.localeCompare(b.dataset.sku!, undefined, { numeric: true })
          : +a.dataset.i! - +b.dataset.i!);
        grid.append(...sorted);
      });
      apply();
    </script>
  </body>
</html>
